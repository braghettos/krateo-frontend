{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "krateo-frontend-agent values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "namespace": {
      "type": "string"
    },
    "requireApproval": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "kagent GRANULAR HITL gate: the exact list of tool names that pause for human approval (kagent requireApproval). Empty = nothing gated. This agent's only mutating-shaped tool, k8s_apply_manifest, is used ONLY as a server DRY-RUN validator (writes nothing), so the default is [] and the real human write gate stays downstream at publishPage (blast-radius). Set e.g. [k8s_apply_manifest] to gate a real apply."
    },
    "modelConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "ModelConfig the agent uses \u2014 referenced by name, or created here (create=true) so this agent's model/provider is configured independently.",
      "properties": {
        "name": {
          "type": "string"
        },
        "create": {
          "type": "boolean"
        },
        "provider": {
          "type": "string",
          "enum": [
            "Anthropic",
            "OpenAI",
            "AzureOpenAI",
            "Ollama",
            "Gemini",
            "GeminiVertexAI",
            "AnthropicVertexAI",
            "Bedrock",
            "SAPAICore"
          ]
        },
        "model": {
          "type": "string"
        },
        "vertexAI": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projectID": {
              "type": "string"
            },
            "location": {
              "type": "string"
            }
          }
        },
        "apiKeySecret": {
          "type": "string"
        },
        "apiKeySecretKey": {
          "type": "string"
        }
      }
    },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string"
        }
      }
    },
    "vertexAI": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "projectID": {
          "type": "string"
        },
        "location": {
          "type": "string"
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mcpServer": {
          "type": "string"
        }
      }
    },
    "fetch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mcpServer": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": true
    },
    "global": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
